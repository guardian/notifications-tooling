{
	"name": "frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun build --watch src/index.html --public-path=/ --outdir=dist --sourcemap --target=browser",
		"build": "bun build ./src/index.html --outdir=dist --sourcemap=none --target=browser --minify --public-path=/ --production",
		"start": "NODE_ENV=production bun src/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test-storybook": "vitest run"
	},
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@guardian/stand": "0.0.73",
		"@hookform/resolvers": "5.9.1",
		"@models": "workspace:*",
		"@tanstack/react-query": "5.102.8",
		"react": "19.2.8",
		"react-aria-components": "1.19.0",
		"react-dom": "19.2.8",
		"react-hook-form": "7.87.0",
		"react-router-dom": "7.18.3",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "20.13.2",
		"@storybook/addon-docs": "10.6.0",
		"@storybook/addon-vitest": "10.6.0",
		"@storybook/builder-vite": "10.6.0",
		"@storybook/react-vite": "10.6.0",
		"@types/bun": "1.4.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitest/browser-playwright": "4.1.11",
		"@vitest/coverage-v8": "4.1.11",
		"eslint-plugin-storybook": "10.6.0",
		"msw": "2.15.0",
		"msw-storybook-addon": "3.0.0",
		"playwright": "1.62.1",
		"storybook": "10.6.0",
		"vitest": "4.1.11"
	}
}
