{
	"name": "frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun build --watch src/index.html --public-path=/ --outdir=dist --sourcemap --target=browser",
		"build": "bun build ./src/index.html --outdir=dist --sourcemap=none --target=browser --minify --public-path=/ --production",
		"start": "NODE_ENV=production bun src/index.ts",
		"typecheck": "tsc --noEmit",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test-storybook": "vitest run"
	},
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@guardian/content-api-models": "47.0.0",
		"@guardian/stand": "0.0.63",
		"react": "19.2.7",
		"react-aria-components": "1.19.0",
		"react-dom": "19.2.7"
	},
	"devDependencies": {
		"@storybook/addon-docs": "10.5.3",
		"@storybook/addon-vitest": "10.5.3",
		"@storybook/react-vite": "10.5.3",
		"@types/bun": "1.3.14",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"eslint-plugin-storybook": "10.5.3",
		"storybook": "10.5.3",
		"vitest": "4.1.10",
		"playwright": "1.62.0",
		"@vitest/browser-playwright": "4.1.10",
		"@vitest/coverage-v8": "4.1.10"
	}
}
