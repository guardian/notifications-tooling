{
	"name": "frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun build --watch src/index.html --public-path=/ --outdir=dist --sourcemap --target=browser",
		"build": "bun build ./src/index.html --outdir=dist --sourcemap=none --target=browser --minify --public-path=/ --production",
		"start": "NODE_ENV=production bun src/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test-storybook": "vitest run"
	},
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@guardian/content-api-models": "47.0.0",
		"@guardian/stand": "0.0.67",
		"@models": "workspace:*",
		"@tanstack/react-query": "5.101.4",
		"react": "19.2.8",
		"react-aria-components": "1.20.0",
		"react-dom": "19.2.8",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@storybook/addon-docs": "10.5.5",
		"@storybook/addon-vitest": "10.5.5",
		"@storybook/react-vite": "10.5.5",
		"@types/bun": "1.3.14",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"eslint-plugin-storybook": "10.5.5",
		"storybook": "10.5.5",
		"vitest": "4.1.10",
		"playwright": "1.62.1",
		"@happy-dom/global-registrator": "20.11.1",
		"@vitest/browser-playwright": "4.1.10",
		"@vitest/coverage-v8": "4.1.10",
		"msw": "2.15.0",
		"msw-storybook-addon": "3.0.0"
	}
}
