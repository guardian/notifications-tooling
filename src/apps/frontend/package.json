{
	"name": "frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"copy-assets": "mkdir -p dist && cp -R public/. dist/",
		"dev": "rm -rf dist && bun run copy-assets && bun build --watch src/index.html --public-path=/ --outdir=dist --sourcemap --target=browser",
		"build": "rm -rf dist && bun run copy-assets && bun build ./src/index.html --outdir=dist --sourcemap=none --target=browser --minify --public-path=/ --production",
		"start": "NODE_ENV=production bun src/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test-storybook": "NODE_OPTIONS='--disable-warning=DEP0205' vitest run"
	},
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@guardian/stand": "2.1.0",
		"@hookform/resolvers": "5.9.2",
		"models": "workspace:*",
		"@tanstack/react-query": "5.104.5",
		"react": "19.3.1",
		"react-aria-components": "1.19.0",
		"react-dom": "19.3.1",
		"react-hook-form": "7.90.0",
		"react-router-dom": "7.18.4",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "20.14.6",
		"@storybook/addon-docs": "10.6.3",
		"@storybook/addon-vitest": "10.6.3",
		"@storybook/builder-vite": "10.6.3",
		"@storybook/react-vite": "10.6.3",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/bun": "1.4.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitest/browser-playwright": "5.0.2",
		"@vitest/coverage-v8": "5.0.2",
		"eslint-plugin-storybook": "10.6.3",
		"msw": "2.15.0",
		"msw-storybook-addon": "3.0.3",
		"playwright": "1.64.1",
		"storybook": "10.6.3",
		"vitest": "5.0.2"
	}
}
