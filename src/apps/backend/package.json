{
	"name": "backend",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"start": "bun run --hot index.ts",
		"dev": "bun run --hot index.ts",
		"build": "bun build app.ts --minify --outfile=dist/handler.js --target=node --format=cjs -e @aws-sdk/* --production --external swagger-ui-dist",
		"test": "bun test",
		"test:db": "bun exec 'bun test ./**/*.dbtest.ts'",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@codegenie/serverless-express": "5.0.0",
		"@types/aws-lambda": "8.10.162",
		"@types/bun": "1.4.0",
		"@types/express": "5.0.6",
		"@types/swagger-ui-express": "4.1.8"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1119.0",
		"@aws-sdk/credential-providers": "3.1119.0",
		"@config": "workspace:*",
		"@database": "workspace:*",
		"@guardian/pan-domain-node": "1.2.5",
		"@guardian/permissions-client": "0.0.4",
		"@http-logger": "workspace:*",
		"@models": "workspace:*",
		"@services": "workspace:*",
		"@utils": "workspace:*",
		"express": "5.2.1",
		"express-zod-safe": "3.2.1",
		"swagger-ui-dist": "5.32.14",
		"swagger-ui-express": "5.0.1",
		"zod": "4.4.3"
	}
}
