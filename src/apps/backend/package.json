{
	"name": "backend",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"start": "bun run --hot index.ts",
		"dev": "bun run --hot index.ts",
		"build": "bun build app.ts --minify --outfile=dist/handler.js --target=node --format=cjs -e @aws-sdk/* --production",
		"db:migration:create": "bun run ../../../scripts/create-db-migration.ts",
		"db:migration:apply": "bun x drizzle-kit migrate --config=drizzle.config.ts",
		"db:reset": "bash db/scripts/reset-db.sh",
		"db:start": "docker compose -f ../../../docker/docker-compose.local.yml up -d",
		"db:stop": "docker compose -f ../../../docker/docker-compose.local.yml down",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@codegenie/serverless-express": "5.0.0",
		"@types/aws-lambda": "8.10.162",
		"@types/bun": "1.3.14",
		"@types/express": "5.0.6",
		"@types/pg": "8.20.0",
		"@types/swagger-ui-express": "4.1.8",
		"dotenv": "17.4.2",
		"drizzle-kit": "0.31.10"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1093.0",
		"@aws-sdk/credential-providers": "3.1093.0",
		"@config": "workspace:*",
		"@guardian/pan-domain-node": "1.2.5",
		"@guardian/permissions-client": "0.0.2",
		"@http-logger": "workspace:*",
		"@utils": "workspace:*",
		"drizzle-orm": "0.45.2",
		"express": "5.2.1",
		"express-zod-safe": "3.2.1",
		"pg": "8.22.0",
		"swagger-ui-express": "5.0.1",
		"zod": "4.4.3"
	}
}
