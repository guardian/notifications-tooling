{
	"name": "@database",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"typecheck": "tsc --noEmit",
		"db:migration:create": "bun run scripts/create-db-migration.ts",
		"db:migration:apply": "bun x drizzle-kit migrate --config=drizzle.config.ts",
		"db:migration:tunnel": "bun run scripts/open-db-migration-tunnel.ts",
		"db:migration:remote-apply": "bun run scripts/prepare-and-apply-remote-db-migrations.ts",
		"db:reset": "bash scripts/reset-db.sh",
		"db:migration:check": "bun x drizzle-kit check --config=drizzle.config.ts"
	},
	"devDependencies": {
		"@types/pg": "8.20.0",
		"drizzle-kit": "0.31.10"
	},
	"dependencies": {
		"@config": "workspace:*",
		"@http-logger": "workspace:*",
		"drizzle-orm": "0.45.2",
		"pg": "8.22.0",
		"zod": "4.4.3"
	}
}
